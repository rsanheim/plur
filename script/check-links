#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
readonly SCRIPT_DIR
PROJECT_ROOT=$(cd "${SCRIPT_DIR}/.." && pwd)
readonly PROJECT_ROOT
DOCS_DIR="${PROJECT_ROOT}/docs"
readonly DOCS_DIR

# Check if uv is installed (mise provides it locally, see .mise.toml)
if ! command -v uv &> /dev/null; then
    echo "Error: uv is not installed."
    echo "Install it with: mise install"
    exit 1
fi

cd "${DOCS_DIR}"

# Ensure dependencies are installed
if ! uv run zensical --version &> /dev/null; then
    echo "Installing Zensical and dependencies..."
    uv sync
fi

echo ">>> Checking markdown links..."

# First, run Zensical build with strict validation
echo ""
echo ">>> Running Zensical validation..."
if uv run zensical build --strict -f "${PROJECT_ROOT}/mkdocs.yml" > "${PROJECT_ROOT}/tmp/zensical-build.log" 2>&1; then
    echo "✓ Zensical validation passed"
else
    echo "✗ Zensical validation failed"
    echo ""
    echo "Zensical errors:"
    cat "${PROJECT_ROOT}/tmp/zensical-build.log"
    exit_code=1
fi

# Run linkcheckmd on the docs directory (checks external links too, so this
# needs network access and can hit rate limits)
echo ""
echo ">>> Running linkcheckmd..."
if uv run python -m linkcheckmd .; then
    echo "✓ linkcheckmd passed"
else
    echo "✗ linkcheckmd found broken links"
    exit_code=1
fi

# Summary
echo ""
if [ "${exit_code:-0}" -eq 0 ]; then
    echo "✓ All link checks passed!"
else
    echo "✗ Link validation failed. Please fix the broken links above."
    exit 1
fi
